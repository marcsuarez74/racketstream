# Backend RacketStream (phase 8) : Deno + SQLite, derrière Caddy.
# Compte dédié rs-api (sans shell ni sudo) — distinct de « racketstream »,
# qui fait tourner MediaMTX et le relais du live.
[Unit]
Description=RacketStream API (Deno + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
User=rs-api
Group=rs-api
WorkingDirectory=/opt/racketstream-api
StateDirectory=racketstream-api
StateDirectoryMode=0750
EnvironmentFile=/etc/racketstream/api.env
Environment=RS_DB=/var/lib/racketstream-api/racketstream.db
Environment=RS_HOST=127.0.0.1
Environment=RS_PORT=8790
Environment=DENO_DIR=/var/lib/racketstream-api/deno
Environment=DENO_NO_UPDATE_CHECK=1
ExecStart=/usr/local/bin/deno run --no-prompt \
  --allow-net=127.0.0.1:8790,api.streamelements.com \
  --allow-read=/opt/racketstream-api,/var/lib/racketstream-api \
  --allow-write=/var/lib/racketstream-api \
  --allow-env=RS_DB,RS_PORT,RS_HOST,SE_JWT,CHAT_ANNOUNCE_KEY \
  server/main.ts
Restart=on-failure
RestartSec=2
MemoryMax=256M

# Durcissement
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/racketstream-api
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
