<!-- Propriétés + écrans de réglage (Phase 4a, spec sync §4.2/§6).
     Propriétés déclarées ici (resources.xsd) — PAS dans manifest.xml :
     le XSD manifest v3 ne les accepte pas (erreur cvc 2.4.a, Task 9). -->
<resources>
    <properties>
        <!-- Syntaxe Garmin (réponse support 21/09) : la valeur par défaut =
             le CONTENU TEXTE de l'élément property (pas d'attribut default=).
             Sans défaut valide, Properties.getValue renvoie null sur matériel.
             backendUrl : défaut = backend VPS (URL publique) ; store build
             = 1 seul champ à remplir (deviceKey) en GCM. -->
        <property id="backendUrl" type="string">https://racket-stream.marc-suarez.fr/functions/v1/sync</property>
        <property id="deviceKey" type="string"></property>
    </properties>
    <settings>
        <setting propertyKey="@Properties.backendUrl" title="Backend URL">
            <settingConfig type="url" required="false"/>
        </setting>
        <setting propertyKey="@Properties.deviceKey" title="Device Key">
            <settingConfig type="alphaNumeric" required="false"/>
        </setting>
    </settings>
</resources>
